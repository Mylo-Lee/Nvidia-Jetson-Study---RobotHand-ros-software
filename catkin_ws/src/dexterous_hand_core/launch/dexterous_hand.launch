<launch>
    <!-- Launch the Virtual Camera Driver Node -->
    <node pkg="dexterous_hand_core" type="camera_driver_node.py" name="camera_driver_node" output="screen" />
    
    <!-- Launch the Main Planning Node -->
    <node pkg="dexterous_hand_core" type="main_planning_node.py" name="main_planning_node" output="screen" />

    <!-- Launch the Hand Actuator Node -->
    <node pkg="dexterous_hand_core" type="hand_actuator_node.py" name="hand_actuator_node" output="screen" />

    <!-- Note: teleop_input_node.py and rqt_image_view are recommended to be run in separate terminals 
         for better user interaction, but we launch teleop here for completeness if needed. 
         Normally, interactive nodes like teleop should run via rosrun in a dedicated terminal. -->
</launch>
