#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import rclpy
from rclpy.node import Node
from std_msgs.msg import String
from sensor_msgs.msg import JointState

class MainPlanningNode(Node):
    def __init__(self):
        super().__init__('main_planning_node')
        self.pub = self.create_publisher(JointState, '/planning/target_joints', 10)
        self.sub = self.create_subscription(String, '/teleop/keyboard_cmd', self.cmd_callback, 10)
        
        self.joint_names = [f'joint_{i}' for i in range(1, 16)]
        self.current_positions = [0.0] * 15
        
        self.get_logger().info("Main Planning Node Initialized. Waiting for commands...")

    def cmd_callback(self, msg):
        cmd = msg.data
        self.get_logger().info(f"Received command: {cmd}, calculating trajectory...")
        
        # Calculate target positions based on command
        if cmd == 'q': # Open
            self.current_positions = [0.0] * 15
        elif cmd == 'w': # Close
            self.current_positions = [1.57] * 15
        elif cmd == 'e': # Pinch
            # Thumb and Index (Assume joint 1, 2, 3, 4 are thumb and index)
            self.current_positions = [0.0] * 15
            self.current_positions[0] = 1.0
            self.current_positions[1] = 1.0
            self.current_positions[2] = 1.0
            self.current_positions[3] = 1.0
        elif cmd == 'r': # Point
            # Index open (0.0), others closed (1.57)
            self.current_positions = [1.57] * 15
            self.current_positions[2] = 0.0
            self.current_positions[3] = 0.0
        elif cmd == 's': # Stop / Reset
            self.current_positions = [0.0] * 15
        else:
            return

        self.publish_joints()

    def publish_joints(self):
        js = JointState()
        js.header.stamp = self.get_clock().now().to_msg()
        js.name = self.joint_names
        js.position = self.current_positions
        self.pub.publish(js)

def main(args=None):
    rclpy.init(args=args)
    node = MainPlanningNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()
